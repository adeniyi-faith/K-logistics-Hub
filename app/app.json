{
  "expo": {
    "name": "K-logistics Hub",
    "slug": "k-logistics-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.klogistics.hub",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.klogistics.hub"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "K-logistics Hub uses the camera for delivery photos, receipt photos and your profile photo.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1E3B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "scheme": "klogistics"
  }
}
